# ---------------------------------------------------------------------------
# CEIL — variables d'environnement
# Copier ce fichier vers `.env` puis adapter les valeurs.
# ---------------------------------------------------------------------------

# Base de données PostgreSQL (correspond au docker-compose.yml fourni)
DATABASE_URL="postgresql://ceil:ceil@localhost:5432/ceil?schema=public"

# ---------------------------------------------------------------------------
# NextAuth (Auth.js)
# Générer un secret : openssl rand -base64 32
# ---------------------------------------------------------------------------
AUTH_SECRET="remplacer-par-un-secret-genere-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="CEIL — Université de Mostaganem"
# Langue par défaut de l'interface : fr | ar
NEXT_PUBLIC_DEFAULT_LOCALE="fr"

# Thème par défaut : dark | light
# Le thème peut être changé par chaque utilisateur via le menu (icône soleil/lune).
# dark  → l'interface est sombre dès le premier affichage (recommandé).
# light → l'interface est claire dès le premier affichage.
NEXT_PUBLIC_DEFAULT_THEME="dark"

# ---------------------------------------------------------------------------
# Seed (comptes de démonstration) — utilisés uniquement par `npm run db:seed`
# ---------------------------------------------------------------------------
SEED_MANAGER_EMAIL="manager@ceil.local"
SEED_MANAGER_PASSWORD="Ceil@Manager2025!"
SEED_USER_EMAIL="user@ceil.local"
SEED_USER_PASSWORD="Ceil@User2025!"
